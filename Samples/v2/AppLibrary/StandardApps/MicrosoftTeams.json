{
    "Name":  "MicrosoftTeams",
    "Source":  {
                   "PreScriptblocks":  [

                                       ],
                   "Evergreen":  [
                                     {
                                         "PreScriptblocks":  [

                                                             ],
                                         "Name":  "MicrosoftTeams",
                                         "Filter":  "$_.Architecture -eq \"x64\" -and $_.Release -eq \"Enterprise\"",
                                         "PostScriptblocks":  [

                                                              ]
                                     }
                                 ],
                   "Download":  [
                                    {
                                        "PreScriptblocks":  [

                                                            ],
                                        "FileName":  "teamsbootstrapper.exe",
                                        "URI":  "https://go.microsoft.com/fwlink/?linkid=2243204\u0026clcid=0x409",
                                        "PostScriotblocks":  [

                                                             ]
                                    }
                                ],
                   "PostScriptblocks":  [

                                        ]
               },
    "Install":  [
                    {
                        "PreScriptblocks":  [
                                                "Sync-LibraryApplicationRegistry -Application $App"
                                            ],
                        "Path":  "C:\\Windows\\System32\\Dism.exe",
                        "Arguments":  "/Online /Add-ProvisionedAppxPackage /PackagePath:\"[SoftwarePath]\\[Name]\\MSTeams-x64.msix\" /SkipLicense",
                        "Recurse":  false,
                        "PostScriptblocks":  [

                                             ]
                    },
                    {
                        "PreScriptblocks":  [

                                            ],
                        "Path":  "[SoftwarePath]\\[Name]\\teamsbootstrapper.exe",
                        "Arguments":  "--installTMA",
                        "Recurse":  true,
                        "PostScriptblocks":  [

                                             ]
                    },
                    {
                        "PreScriptblocks":  [

                                            ],
                        "Path":  "[SoftwarePath]\\[Name]\\teamsbootstrapper.exe",
                        "Arguments":  "-p",
                        "Recurse":  true,
                        "PostScriptblocks":  [

                                             ]
                    }
                ],
    "Registry":  [
                     {
                         "PreScriptblocks":  [

                                             ],
                         "Path":  "hklm:\\SOFTWARE\\Microsoft\\Windows\\Appx",
                         "Name":  "AllowAllTrustedApps",
                         "Value":  "1",
                         "Type":  "DWord",
                         "PostScriptblocks":  [

                                              ]
                     },
                     {
                         "PreScriptblocks":  [

                                             ],
                         "Path":  "hklm:\\SOFTWARE\\Microsoft\\Windows\\Appx",
                         "Name":  "MdmHosts",
                         "Value":  "^(?:[^/]*)\\.MANAGE[^\\.]*\\.(MICROSOFT\\.(COM|US)|MICROSOFTONLINE\\.CN)$",
                         "Type":  "String",
                         "PostScriptblocks":  [

                                              ]
                     }
                 ],
    "Detection":  {
                  }
}
