                "#PowerShell.exe -NonInteractive -Command { & (Join-Path $OSOTPath \"OmnissaHorizonOSOptimizationTool.exe\") -Finalize All }",
                "& \"$OSOT\" -Finalize All",
                "If ($State.Pause) { Read-Host \"Pausing before shutdown, press enter to continue\" }",
                "Stop-Computer"
            ]
        }
    }
}