            "Name":"Software",
            "Source":"\\\\contoso.com\\Horizon\\Software\\*",
            "Destination":"c:\\Temp\\Software\\"
        }
    ],
    "Fileshares":[],
    "Variables":[
        {
            "Name":"DriverPath",
            "Value":"\\\\contoso.com\\Horizon\\Master\\Drivers"
        },
        {
            "Name":"LibraryPath",
            "Value":"C:\\Temp\\Scripts\\AppLibrary\\"
        },
        {
            "Name":"OSOTPath",
            "Value":"C:\\Temp\\OSOT"
        },
        {
            "PreScriptBlocks":[
                "$Variable.Value = (Get-ChildItem (Join-Path $OSOTPath \"*OSOptimizationTool*.exe\") -ErrorAction SilentlyContinue).FullName"
            ],
            "Name":"OSOT",
            "Value":""
        },
        {
            "Name":"ScriptPath",
            "Value":"C:\\Temp\\Scripts"
        },
        {
            "Name":"SoftwarePath",
            "Value":"C:\\Temp\\Software"
        }
    ],
    "Phases":{
        "0":{
            "PreScriptBlocks":[
                "$Environment.Copy | ForEach-Object { Copy-ItemWrapper -Path $_.Source -Destination $_.Destination }",
                "Initialize-Variables -Variables $Variables",
                "Unblock-File -Path (Join-Path $ScriptPath \"Start-BaseCreation.bat\")",
                "#-----Get-AppsEvergreen -Applications $Environment.Evergreen -DownloadPath $SoftwarePath",
                "#-----Get-AppsDownload -Applications $Environment.Download -DownloadPath $SoftwarePath",
                "Get-AppsVCRedist -Releases $Environment.VCRedist -Path (Join-Path $SoftwarePath \"VCRedist\")",
                "Install-Drivers -Path $DriverPath",
                "Initialize-PrinterDrivers $Environment.PrinterDrivers",
                "Initialize-ZebraDrivers $Environment.ZebraDrivers",
                "Add-AntivirusExclusions -FSLogixPaths $Environment.DC.($State.DC).FSLogixPaths"
            ],
            "Applications":[
                "VCRedist200X_2010_2012",
                "VCRedist2013-2019",
                "VCRedist14",
                "MicrosoftOffice365",
                "MicrosoftOneDrive",
                "MicrosoftSQLNativeClient",
                "Microsoft.NetSDK*",
                "MicrosoftEdge",
                "MicrosoftEdgeWebView2",
                "MicrosoftVSTA2017",
                "MicrosoftReportViewerRuntime",
                "MicrosoftODBCDriverForSQLServer17",
                "MicrosoftOLEDBDriverForSQLServer",
                "MicrosoftOpenJDK21",
                "MicrosoftWSE3",
                "RSAT-Offline"
            ],
            "RegistrySettings":[
                {
                    "Path":"hklm:\\SOFTWARE\\Omnissa\\Horizon\\OS Optimization Tool",
                    "Name":"EUALAcceptedV1",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
                    "Name":"ExcludeWUDriversInQualityUpdate",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
                    "Name":"TargetReleaseVersion",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate",
                    "Name":"TargetReleaseVersionInfo",
                    "Value":"25H2",
                    "Type":"String"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
                    "Name":"NoAutoUpdate",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
                    "Name":"EnableFeaturedSoftware",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
                    "Name":"AutoInstallMinorUpdates",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
                    "Name":"AllowMUUpdateService",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Microsoft\\Windows\\Appx",
                    "Name":"AllowAllTrustedApps",
                    "Value":"1",
                    "Type":"DWord"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Microsoft\\Windows\\Appx",
                    "Name":"MdmHosts",
                    "Value":"^(?:[^\/]*)\\.MANAGE[^\\.]*\\.(MICROSOFT\\.(COM|US)|MICROSOFTONLINE\\.CN)$",
                    "Type":"String"
                },
                {
                    "Path":"hklm:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WorkplaceJoin",
                    "Name":"BlockAADWorkplaceJoin",
                    "Value":"1",
                    "PropertyType":"Dword"
                }
            ],
            "PostScriptBlocks":[
                "$ISO = Get-Childitem (Join-Path $softwarePath \"WindowsOptionalFeatures\\*.iso\")",
                "$Mount = $ISO | Mount-DiskImage",
                "$Source = (Get-Volume -DiskImage ($ISO | Get-DiskImage)).Driveleter += \":\\LanguagesAndOptionalFeatures\"",
                "Get-WindowsCapability -Online -Name RSAT* | Add-WindowsCapability -Online -LimitAccess -Source $Source",
                "Get-Service -Name wuauserv | Restart-Service",
                "Update-Help -ErrorAction SilentlyContinue -Force",
                "$State.Phase++",
                "Set-ItemProperty -Path $EnvironmentVariables -Name \"State\" -value ($State | ConvertTo-Json)",
                "Update-Windows",
                "If ($State.Pause) { Read-Host \"Pausing before reboot, press enter to continue\" }",
                "Restart-Computer -Force"
            ]
        },
        "1":{
            "PreScriptBlocks":[
                "Update-Windows -Reboot",
                "Restart-OnPending"
            ],
            "Applications":[
                "OmnissaHorizonAgent",
                "OmnissaDEM"
            ],
            "RegistrySettings":[],
            "PostScriptBlocks":[
                "$State.Phase++",
                "Set-ItemProperty -Path $EnvironmentVariables -Name \"State\" -value ($State | ConvertTo-Json)",
                "If ($State.Pause) { Read-Host \"Pausing before Optimize & Generalize, press enter to continue\" }",
                "Restart-Computer"
            ]
        },
        "2":{
            "PreScriptBlocks":[
                "Update-Windows -Reboot",
                "Restart-OnPending"
            ],
            "Applications":[
            ],
            "RegistrySettings":[
            ],
            "PostScriptBlocks":[
                "$State.Phase++",
                "Set-ItemProperty -Path $EnvironmentVariables -Name \"State\" -value ($State | ConvertTo-Json)",
                "If ($State.Pause) { Read-Host \"Pausing before reboot, press enter to continue\" }",
                "& \"$OSOT\" -generalize -reboot"
            ]
        },
        "3":{
            "PreScriptBlocks":[
                "Update-Windows -Reboot",
                "Restart-OnPending",
                "if ((get-service W32Time).Status -ne \"Running\") { Start-Service -Name W32Time }",
                "C:\\windows\\system32\\w32tm.exe /config /update /manualpeerlist:\"$($Environment.DC.Domain)\"",
                "C:\\Windows\\System32\\w32tm.exe /resync /rediscover"
            ],
            "Applications":[
                    "OmnissaAppVolumesAgent",
                    "MicrosoftFSLogixApps"
            ],
            "RegistrySettings":[
                {
                    "Path":"hklm:\\SYSTEM\\CurrentControlSet\\services\\svdriver\\Parameters",
                    "Name":"AllowInstallerModification",
                    "Value":"1",
                    "PropertyType":"Dword"
                },
                {
                    "PreScriptBlocks":  [
                        "$RegistrySetting.Value = $Environment.DC.($State.DC).AppVol.Manager2"
                    ],
                    "Path":"hklm:\\SYSTEM\\CurrentControlSet\\services\\svdriver\\Parameters",
                    "Name":"Manager2",
                    "Value":"",
                    "PropertyType":"String"
                }
            ],
            "PostScriptBlocks":[
                "$State.Phase++",
                "Set-ItemProperty -Path $EnvironmentVariables -Name \"State\" -value ($State | ConvertTo-Json)",
                "If ($State.Pause) { Read-Host \"Pausing before reboot, press enter to continue\" }",
                "& \"$OSOT\" -optimize -v",
                "Restart-Computer"
            ]
        },
        "4":{
            "PreScriptBlocks":[
                "#Read-Host \"Please make any manual changes, press Enter to continue\""
            ],
            "Applications":[
                "MicrosoftTeamsBootStrapper",
                "MicrosoftTeamsMSIX" 
            ],
            "RegistrySettings":[
            ],
            "PostScriptBlocks":[
                "Get-ChildItem \"c:\\users\\*\\Desktop\\*.lnk\" | Remove-Item -Force",
                "Remove-Item $SoftwarePath -Recurse -Force",
                "#New-LocalUser -name \"AppCap\" -password (ConvertTo-SecureString -String \"P@ssw0rd\" -AsPlainText -Force) -PasswordNeverExpires -UserMayNotchangePassword",
                "#Add-LocalGroupMember -group \"Administrators\" -Member \"AppCap\"",
                "#Set-LocalUser -Name \"Administrator\" -Password (ConvertTo-SecureString -String \"P@ssw0rd\" -AsPlainText -Force)",
                "$Run = \"hklm:\\software\\microsoft\\windows\\currentversion\\run\"",
                "If ((Get-Item $Run).Property -contains \"*Image\") { Remove-ItemProperty -Path $Run -Name \"*Image\" }",
                "#PowerShell.exe -NonInteractive -Command { & (Join-Path $OSOTPath \"OmnissaHorizonOSOptimizationTool.exe\") -Finalize All }",
                "& \"$OSOT\" -Finalize All",
                "If ($State.Pause) { Read-Host \"Pausing before shutdown, press enter to continue\" }",
                "Stop-Computer"
            ]
        }
